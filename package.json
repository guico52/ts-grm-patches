{
  "name": "ts-grm-patches",
  "version": "0.2.1",
  "description": "Extension patches for ts-grm: column-level autoIncrement/default for DDL and migrations, global query filters, and BOOL/TEXT columns in query expressions",
  "keywords": [
    "ts-grm",
    "orm",
    "schema-migration",
    "auto-increment",
    "default-value",
    "global-filter",
    "multi-tenant",
    "patch"
  ],
  "license": "MIT",
  "author": "guico <1305487489@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guico52/ts-grm-patches.git"
  },
  "homepage": "https://github.com/guico52/ts-grm-patches#readme",
  "bugs": {
    "url": "https://github.com/guico52/ts-grm-patches/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "files": [
    "dist",
    "docs",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@ts-grm/core": ">=0.0.13 <0.0.14",
    "@ts-grm/sql": ">=0.0.13 <0.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ts-grm/core": "0.0.13",
    "@ts-grm/sql": "0.0.13",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
